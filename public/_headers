# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# OG font and other static fonts (Workers Assets)
/fonts/*
  Cache-Control: public,max-age=31536000,immutable

# Timeline music (src/components/riders/TimelinePlayer.tsx). Not immutable:
# the name carries no hash, so a replaced file must still reach readers.
/audio/*
  Cache-Control: public,max-age=86400

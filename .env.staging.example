# Staging build environment (wildrunner-org-next-staging.workers.dev).
#
# Loaded explicitly by `pnpm build:staging`. Same rules as .env.production:
# .env.local is still auto-loaded and outranks a bare .env.<mode> file, so
# everything that matters is stated here, blanks included.
NEXT_PUBLIC_SITE_URL=https://wildrunner-org-next-staging.small-tooth-cc10.workers.dev
NEXT_PUBLIC_ENV=staging
# Staging's own R2 bucket, not the production media domain. Migrated media
# rows still point at images.wildrunner.org, which staging only reads.
R2_PUBLIC_URL=https://pub-f82e5464c241415f9ea3f879e8f46e7f.r2.dev

# Distinct from production on purpose: a leaked staging secret must not be
# able to forge production JWTs or password-reset tokens. Passwords are
# unaffected (pbkdf2 with a per-user salt), so accounts still work.
# The REAL secrets live as Worker secrets:
#   wrangler secret put PAYLOAD_SECRET --env <env>
#   wrangler secret put RESEND_API_KEY --env <env>
# OpenNext's populateProcessEnv assigns Cloudflare vars/secrets first and
# only fills gaps from build-time values (`??=`), so the Worker secret wins
# at runtime and the real value never enters the deployed bundle.
#
# PAYLOAD_SECRET still needs *a* value at build time — Payload refuses to
# initialise without one while Next collects page data — so this is a
# throwaway placeholder. It signs nothing: every request runs with the
# Worker secret. Set explicitly (not left blank) because .env.local is
# still auto-loaded by Next and would otherwise supply the real key here.
PAYLOAD_SECRET=build-only-placeholder-not-used-at-runtime

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@wildrunner.org
RESEND_FROM_NAME=野馬營

MEMBER_STORAGE_QUOTA_MB=10240
STREAM_INGEST=false

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# Optional. Authorises POST /api/races/maintenance, called daily by
# .github/workflows/race-schedule-maintenance.yml. Generate with
# `openssl rand -hex 32`. In staging/production supply it as a Worker
# secret (`wrangler secret put RACE_MAINTENANCE_SECRET --env <env>`), never
# as a build-time value — assert-no-secrets-in-bundle.mjs enforces that.
# Leaving it unset does not affect the site: only that endpoint refuses,
# and the daily workflow skips itself with a warning. Not required by
# preflight:prod.
RACE_MAINTENANCE_SECRET=

{
  "name": "wildrunner.org-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:turbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:content": "node --env-file-if-exists=.env.local ./node_modules/velite/bin/velite.js --watch",
    "content": "node --env-file-if-exists=.env.local ./node_modules/velite/bin/velite.js",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:content": "node --env-file-if-exists=.env.local ./node_modules/velite/bin/velite.js && next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "preview": "opennextjs-cloudflare build && node scripts/patch-assets-headers.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/patch-assets-headers.mjs && node scripts/deploy-with-build-id.mjs",
    "upload": "opennextjs-cloudflare build && node scripts/patch-assets-headers.mjs && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:smoke": "playwright test --config=playwright.config.ts e2e/deployed",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "assert:bindings": "node scripts/assert-bindings.mjs",
    "assert:lfs": "node scripts/assert-no-lfs-in-builds.mjs",
    "assert:tests": "node scripts/assert-test-strategy.mjs",
    "assert:lexical": "node scripts/assert-lexical-single-copy.mjs",
    "migrate:velite": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/migrate-velite-to-payload.ts",
    "migrate:velite:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/migrate-velite-to-payload.ts --dry-run",
    "migrate:velite:remote": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/migrate-velite-to-payload.ts --remote",
    "seed:races:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/seed-race-schedule.ts --dry-run",
    "report:originals": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/report-transcode-originals.ts",
    "report:originals:prod": "cross-env TRANSCODE_ORIGINALS_DB=wildrunner-org-next NODE_OPTIONS=--no-deprecation tsx scripts/report-transcode-originals.ts",
    "seed:races": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/seed-race-schedule.ts",
    "seed:races:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/seed-race-schedule.ts --remote",
    "seed:races:prod": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=production NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/seed-race-schedule.ts --remote",
    "media:backfill-size": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-media-filesize.ts",
    "media:backfill-size:prod": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-media-filesize.ts",
    "media:usage": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/backfill-media-usage.ts",
    "media:posters": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/backfill-video-posters.ts",
    "media:posters:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-video-posters.ts",
    "media:posters:prod": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-video-posters.ts",
    "media:usage:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-media-usage.ts",
    "media:usage:prod": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/backfill-media-usage.ts",
    "media:orphans": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/find-orphan-media.ts",
    "media:orphans:prod": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/find-orphan-media.ts",
    "cleanup:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/cleanup-staging-test-data.ts",
    "sync:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/sync-prod-content-to-staging.ts",
    "build:staging": "node scripts/with-env.mjs .env.staging opennextjs-cloudflare build --env staging",
    "deploy:staging": "pnpm run build:staging && node scripts/assert-no-secrets-in-bundle.mjs && node scripts/patch-assets-headers.mjs && cross-env CLOUDFLARE_ENV=staging node scripts/deploy-with-build-id.mjs --env staging",
    "preflight:prod": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.production scripts/preflight-production.ts",
    "build:prod": "node scripts/with-env.mjs .env.production opennextjs-cloudflare build",
    "deploy:prod": "pnpm run build:prod && node scripts/assert-no-secrets-in-bundle.mjs && node scripts/patch-assets-headers.mjs && node scripts/deploy-with-build-id.mjs",
    "seed:e2e:account": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/seed-e2e-account.ts",
    "seed:catalogue": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/csv-to-seed.ts",
    "validate:catalogue": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/validate-catalogue.ts",
    "validate:editions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/validate-race-editions.ts",
    "refresh:editions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/refresh-race-editions.ts",
    "capture:badges": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/capture-badges.ts",
    "seed:editions:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/import-race-editions.ts",
    "seed:editions": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/import-race-editions.ts --write",
    "assert:schema-screen": "node scripts/assert-schema-screen.mjs",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "seed:editions:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/import-race-editions.ts --remote --write",
    "seed:editions:prod": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=production NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/import-race-editions.ts --remote --write",
    "seed:qualifiers:dry": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/import-race-qualifiers.ts",
    "seed:qualifiers": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env.local scripts/import-race-qualifiers.ts --write",
    "seed:qualifiers:staging": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=staging NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/import-race-qualifiers.ts --remote --write",
    "seed:qualifiers:prod": "cross-env NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=production NODE_ENV=production tsx --env-file-if-exists=.env.local scripts/import-race-qualifiers.ts --remote --write",
    "generate:zh-hans": "tsx scripts/generate-zh-hans.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@iconify-icon/react": "^2.3.0",
    "@lexical/table": "0.41.0",
    "@payloadcms/db-d1-sqlite": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-r2": "3.87.0",
    "@payloadcms/translations": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "16.4.7",
    "exifreader": "^4.33.1",
    "framer-motion": "^11.18.2",
    "graphql": "^16.8.1",
    "hast-util-sanitize": "^5.0.2",
    "heic-convert": "^2.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.477.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "opencc-js": "1.4.2",
    "payload": "3.87.0",
    "photoswipe": "^5.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-photo-album": "^3.5.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-preset-minify": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-emoji": "^5.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^1.29.2",
    "swiper": "^11.2.10",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "usehooks-ts": "^3.1.1",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.56.1",
    "@types/heic-convert": "^2.1.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "velite": "^0.3.1",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  }
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "wildrunner-org-next",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "wildrunner-org-next",
			"database_id": "e106e1c4-9e29-4cad-b78f-2d3cc169ec8c"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "wildrunner-org-next"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "wildrunner-storage"
		},
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "wildrunner-org-next-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"stream": {
		"binding": "STREAM",
		"remote": true
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Non-secret runtime config. Code in this repo reads process.env.X in two
	// different places with two different lifetimes: a module-top-level read
	// (e.g. payload.config.ts's `secret: process.env.PAYLOAD_SECRET`) gets
	// evaluated once during `next build`, so a value in .env.local on the
	// build machine is baked into the bundle as a literal — but a read
	// inside a request handler (e.g. isEmailConfigured() in
	// src/lib/email.ts, called per-request) is evaluated by the deployed
	// Worker at runtime, where process.env only reflects real Workers
	// bindings (`vars` here, or `wrangler secret put`) — .env.local is never
	// seen by a deployed Worker at all. Confirmed the hard way: an invite
	// silently never sent until RESEND_API_KEY was set as a real secret.
	"vars": {
		"RESEND_FROM_ADDRESS": "noreply@wildrunner.org",
		"RESEND_FROM_NAME": "野馬營",
		"MEMBER_STORAGE_QUOTA_MB": "10240"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Production: zone routes on wildrunner.org (DNS proxied in Cloudflare).
	"routes": [
		{
			"pattern": "wildrunner.org/*",
			"zone_name": "wildrunner.org"
		},
		{
			"pattern": "www.wildrunner.org/*",
			"zone_name": "wildrunner.org"
		}
	],
	// Staging: isolated Worker, workers.dev only, no custom domain routes.
	// Reuses the same D1/R2 that production will eventually use, so the
	// migrated content here is exactly what cuts over later.
	"env": {
		"staging": {
			"name": "wildrunner-org-next-staging",
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"d1_databases": [
				{
					"binding": "D1",
					"database_name": "wildrunner-org-next",
					"database_id": "e106e1c4-9e29-4cad-b78f-2d3cc169ec8c",
					"remote": true
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "wildrunner-org-next-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "wildrunner-storage",
					"remote": true
				},
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "wildrunner-org-next-opennext-cache",
					"remote": true
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"ai": {
				"binding": "AI",
				"remote": true
			},
			"stream": {
				"binding": "STREAM",
				"remote": true
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1
			},
			"vars": {
				"RESEND_FROM_ADDRESS": "noreply@wildrunner.org",
				"RESEND_FROM_NAME": "野馬營",
				"MEMBER_STORAGE_QUOTA_MB": "10240"
			},
			"workers_dev": true,
			"preview_urls": true,
			// Explicit empty routes: wrangler environments inherit top-level
			// `routes` unless overridden, so without this the staging deploy
			// tries to claim wildrunner.org/* for this worker too (only a 409
			// from Cloudflare, because the production Worker already owns
			// those routes, stopped that from actually happening).
			"routes": []
		}
	}
}

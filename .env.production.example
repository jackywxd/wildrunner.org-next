# Production build environment (wildrunner.org).
#
# Loaded explicitly by `pnpm build:prod`; NOT auto-loaded by Next.
# Next still auto-loads .env.local during any build, and .env.local has
# HIGHER precedence than .env.production — so every value that must not
# come from .env.local is set here explicitly, including the blanks below.
# Which Cloudflare environment's D1/R2 this build resolves. Read by
# payload.config inside the `next build` child process, which the
# `--env` wrangler flag does not reach. Leaving it out is what let two
# staging builds migrate the production database.
# CLOUDFLARE_ENV — LEAVE THIS UNSET FOR PRODUCTION.
#
# wrangler names the top-level environment by its *absence*. wrangler.jsonc
# has exactly one `env` section, `staging`; production is the top level. So
# CLOUDFLARE_ENV=production resolves to nothing and every wrangler-backed
# command dies with "No environment found in configuration with name
# production".
#
# This file used to set it, and because scripts/with-env.mjs deliberately
# overrides pre-existing process.env entries, unsetting it in the shell did
# not help. See AGENTS.md, "The two environment variables".
# CLOUDFLARE_ENV=

NEXT_PUBLIC_SITE_URL=https://wildrunner.org
NEXT_PUBLIC_ENV=production
R2_PUBLIC_URL=https://images.wildrunner.org

# The REAL secrets live as Worker secrets:
#   wrangler secret put PAYLOAD_SECRET --env <env>
#   wrangler secret put RESEND_API_KEY --env <env>
# OpenNext's populateProcessEnv assigns Cloudflare vars/secrets first and
# only fills gaps from build-time values (`??=`), so the Worker secret wins
# at runtime and the real value never enters the deployed bundle.
#
# PAYLOAD_SECRET still needs *a* value at build time — Payload refuses to
# initialise without one while Next collects page data — so this is a
# throwaway placeholder. It signs nothing: every request runs with the
# Worker secret. Set explicitly (not left blank) because .env.local is
# still auto-loaded by Next and would otherwise supply the real key here.
PAYLOAD_SECRET=build-only-placeholder-not-used-at-runtime

RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@wildrunner.org
RESEND_FROM_NAME=野馬營

MEMBER_STORAGE_QUOTA_MB=10240
STREAM_INGEST=false

# Deliberately blank. These are R2 *write* credentials used only by the
# offline Velite pipeline, and OpenNext inlines the whole build env into
# the deployed bundle. Empty (not absent) so they override .env.local.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# Optional. Authorises POST /api/races/maintenance, called daily by
# .github/workflows/race-schedule-maintenance.yml. Generate with
# `openssl rand -hex 32`. In staging/production supply it as a Worker
# secret (`wrangler secret put RACE_MAINTENANCE_SECRET --env <env>`), never
# as a build-time value — assert-no-secrets-in-bundle.mjs enforces that.
# Leaving it unset does not affect the site: only that endpoint refuses,
# and the daily workflow skips itself with a warning. Not required by
# preflight:prod.
RACE_MAINTENANCE_SECRET=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# Velite output (.velite/) is committed so Workers Builds can deploy without
# running Velite or checking out ~11GB of Git LFS media.
# Velite may copy linked assets here during local builds; media lives in R2 / src/content
# Keep brand SVGs tracked for header / dark mode logos.
/public/static/*
!/public/static/brand/
!/public/static/brand/**

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

/test-results/
/playwright-report/
/blob-report/
/reports/
.tmp-payload-template/

# Database dumps. `wrangler d1 export` output carries members' real emails and
# bcrypt hashes, and this repository is public — so the rule in AGENTS.md ("A
# deployed database is not touched until there is a way back") gets a mechanical
# half here rather than living only in prose. The names are the ones
# docs/production-cutover.md and docs/workers-builds.md tell you to write;
# scripts/sql/ stays tracked because only the repo root is swept.
/*.sql
prod-backup-*.sql
backup*.sql

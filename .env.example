NEXT_PUBLIC_SITE_URL=https://wildrunner.org
NEXT_PUBLIC_ENV=development
# Optional: Cloudflare Web Analytics token (Dashboard → Analytics & Logs → Web Analytics)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
R2_PUBLIC_URL=https://images.wildrunner.org
# Required by Payload. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Optional Cloudflare Stream customer subdomain code (iframe embed)
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=
# Cloudflare Stream is OFF. It bills per stored minute, and gallery videos
# play directly from R2 via the browser's native player (range requests are
# supported, so seeking works). Set STREAM_INGEST=true after buying Stream
# capacity to start ingesting; the player already prefers Stream whenever a
# video has a streamId, so nothing else needs changing.
STREAM_INGEST=false
# Additionally required to ingest from local development.
STREAM_INGEST_IN_DEV=false
# Per-member storage cap in MB (images + video). Override per account via
# users.storageQuotaMb in the admin. Does not apply to admins.
MEMBER_STORAGE_QUOTA_MB=10240
# Invitation email via Resend (Workers cannot use SMTP). Leave RESEND_API_KEY
# empty and the invite endpoint returns the link for the admin to pass on by
# hand instead — the flow works either way.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@wildrunner.org
RESEND_FROM_NAME=野馬營
# Legacy Velite content pipeline (local only; not used by Workers Builds)
S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

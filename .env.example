NEXT_PUBLIC_SITE_URL=https://wildrunner.org
NEXT_PUBLIC_ENV=development
# Optional: Cloudflare Web Analytics token (Dashboard → Analytics & Logs → Web Analytics)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
R2_PUBLIC_URL=https://images.wildrunner.org
# Required by Payload. Generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Optional Cloudflare Stream customer subdomain code (iframe embed)
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=
# Admin video uploads ingest automatically in production through the STREAM binding.
# Set only when intentionally testing paid Stream ingestion in local development.
STREAM_INGEST_IN_DEV=false
# Legacy Velite content pipeline (local only; not used by Workers Builds)
S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
